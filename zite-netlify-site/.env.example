# Copy this file to .env for local development with `netlify dev`.
# In production, set these in Netlify: Site settings → Environment variables.
# NEVER commit the real .env file.

# Your Zite API key (Zite dashboard → Settings → Developer)
ZITE_API_KEY=

# The database (base) ID — already set to your Quantum Freelance Hub database
ZITE_DATABASE_ID=ac388e59ebc6c188

# A password of your choosing that gates /admin. Share it only with admins.
ADMIN_PASSWORD=
